---
interface Props {
	eyebrow: string;
	title: string;
	description?: string;
	centered?: boolean;
	light?: boolean;
}

const { eyebrow, title, description, centered = false, light = false } = Astro.props;
---

<div class:list={['section-heading', { centered }]}>
	<p class:list={['eyebrow', { light }]}>{eyebrow}</p>
	<h2>{title}</h2>
	{description && <p>{description}</p>}
</div>
