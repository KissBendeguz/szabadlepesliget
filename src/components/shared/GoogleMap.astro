---
import { site } from '../../data/site';

interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
---

<div class:list={['google-map', { 'google-map-compact': compact }]} data-map-loader>
	<div class="map-placeholder" data-map-placeholder>
		<span class="map-pin"><i class="bi bi-geo-alt" aria-hidden="true"></i></span>
		<div>
			<strong>{site.name}</strong>
			<address>{site.fullAddress}</address>
		</div>
		<button class="button button-warm" type="button" data-map-load>Térkép betöltése</button>
		<a class="text-link" href={site.mapsPlaceLink} target="_blank" rel="noopener noreferrer">Megnyitás a Google Térképen <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></a>
	</div>
	<iframe
		title={`${site.name} helye a Google Térképen`}
		data-src={site.mapsEmbedLink}
		loading="lazy"
		referrerpolicy="no-referrer-when-downgrade"
		allowfullscreen
		hidden
	></iframe>
</div>

<script>
	document.querySelectorAll<HTMLElement>('[data-map-loader]').forEach((map) => {
		const button = map.querySelector<HTMLButtonElement>('[data-map-load]');
		const placeholder = map.querySelector<HTMLElement>('[data-map-placeholder]');
		const frame = map.querySelector<HTMLIFrameElement>('iframe[data-src]');
		if (!button || !placeholder || !frame || button.dataset.ready === 'true') return;
		button.dataset.ready = 'true';
		button.addEventListener('click', () => {
			frame.src = frame.dataset.src ?? '';
			frame.hidden = false;
			placeholder.hidden = true;
		});
	});
</script>
