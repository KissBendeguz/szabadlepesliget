---
import { pageLabel } from '../../data/pages';
interface Props { path: string; }
const { path } = Astro.props;
const parts = path.split('/');
const crumbs = parts.map((_, index) => {
	const currentPath = parts.slice(0, index + 1).join('/');
	return { href: `/${currentPath}/`, label: pageLabel(currentPath) };
});
---
<nav class="breadcrumbs" aria-label="Morzsanavigáció"><ol><li><a href="/">Kezdőlap</a></li>{crumbs.map((crumb, index) => <li>{index < crumbs.length - 1 ? <a href={crumb.href}>{crumb.label}</a> : <span aria-current="page">{crumb.label}</span>}</li>)}</ol></nav>
