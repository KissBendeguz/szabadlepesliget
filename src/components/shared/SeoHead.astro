---
import { site } from '../../data/site';

interface Props { title: string; description: string; canonical?: URL; noindex?: boolean; }
const { title, description, canonical, noindex = false } = Astro.props;
const origin = canonical?.origin;
const image = origin ? new URL('/og-image.png', origin).href : '/og-image.png';
const structuredData = canonical ? {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': ['LocalBusiness', 'SportsActivityLocation'],
			'@id': `${origin}/#business`,
			name: site.name,
			url: origin,
			image,
			logo: image,
			telephone: site.phoneDisplay,
			email: site.email,
			address: { '@type': 'PostalAddress', postalCode: site.postalCode, addressLocality: site.location, addressRegion: site.addressRegion, addressCountry: 'HU' },
			areaServed: [
				{ '@type': 'City', name: site.location },
				{ '@type': 'AdministrativeArea', name: site.region },
				{ '@type': 'AdministrativeArea', name: 'Balaton-felvidék' },
			],
			hasOfferCatalog: {
				'@type': 'OfferCatalog',
				name: 'Lovas foglalkozások',
				itemListElement: site.services.map((service) => ({
					'@type': 'Offer',
					itemOffered: { '@type': 'Service', name: service.name, url: new URL(service.url, origin).href, provider: { '@id': `${origin}/#business` } },
				})),
			},
			sameAs: site.socials.map((social) => social.href),
		},
		{ '@type': 'WebSite', '@id': `${origin}/#website`, url: origin, name: site.name, inLanguage: 'hu-HU', publisher: { '@id': `${origin}/#business` } },
		{ '@type': 'WebPage', '@id': `${canonical.href}#webpage`, url: canonical.href, name: title, description, inLanguage: 'hu-HU', isPartOf: { '@id': `${origin}/#website` }, about: { '@id': `${origin}/#business` }, primaryImageOfPage: { '@type': 'ImageObject', url: image } },
	],
} : undefined;
---
<meta name="description" content={description} />
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
{canonical && <link rel="canonical" href={canonical.href} />}
<meta property="og:type" content="website" /><meta property="og:locale" content="hu_HU" /><meta property="og:site_name" content={site.name} /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:image" content={image} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content={`${site.name} logó`} />
{canonical && <meta property="og:url" content={canonical.href} />}
<meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={image} /><meta name="twitter:image:alt" content={`${site.name} logó`} />
{structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
