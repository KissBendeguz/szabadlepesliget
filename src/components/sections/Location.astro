---
import { site } from '../../data/site';
import GoogleMap from '../shared/GoogleMap.astro';
---

<section class="location section">
	<div class="container location-grid">
		<div class="location-copy">
			<p class="eyebrow">Itt találsz minket</p>
			<h2>Szabad Lépés Liget — lóasszisztált foglalkozások Káptalantóti természetközeli környezetében</h2>
			<p class="lead">A ZsM Lovasudvar Káptalantótiban, a Káli-medence és a Balaton-felvidék különleges tájai között vár — távol a városi zajtól, közel a természethez.</p>
			<div class="location-info">
				<div>
					<i class="bi bi-geo-alt" aria-hidden="true"></i>
					<p><strong>{site.name}</strong><br /><a href={site.mapsPlaceLink} target="_blank" rel="noopener noreferrer">{site.fullAddress}</a><br /><small>Előzetes bejelentkezéssel</small></p>
				</div>
				<div>
					<i class="bi bi-telephone" aria-hidden="true"></i>
					<p><strong>Telefon</strong><br /><a href={site.phoneLink}>{site.phoneDisplay}</a></p>
				</div>
			</div>
			<div class="button-row">
				<a class="button" href={site.mapsDirectionsLink} target="_blank" rel="noopener noreferrer">Útvonalat tervezek <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></a>
				<a class="text-link" href="/kornyek/">Fedezd fel a környéket <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
			</div>
		</div>
		<GoogleMap />
	</div>
</section>
