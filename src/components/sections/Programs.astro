---
const programs = [
	{
		id: "gyerekeknek",
		href: "/lovaglas/gyerek-lovaglas/",
		image: "/gallery/4999ae9c-6d55-4fe7-82ce-67ed8c19cb83.webp",
		alt: "Gyermek játékos gyakorlatot végez a ló hátán",
		label: "Játék · mozgás · öröm",
		eyebrow: "Gyerekeknek",
		title: "Bátorító első lépések, örömteli fejlődés",
		text: "A ló hátán a mozgás kalanddá válik. Játékos feladatokkal, sok dicsérettel és a gyermek tempójához igazodva teremtünk lehetőséget a kibontakozásra.",
		items: [
			"egyensúly és koordináció támogatása",
			"figyelem és önbizalom erősítése",
			"biztonságos ismerkedés a lovakkal",
		],
		cta: "Részletek gyerekeknek",
	},
	{
		id: "felnotteknek",
		href: "/lovaglas/felnott-lovaglas/",
		reverse: true,
		image: "/gallery/1f090c7c-81cd-4739-8745-70c342a5adca.webp",
		alt: "Felnőtt lovas foglalkozás a ZsM Lovasudvarban",
		label: "Bizalom · jelenlét · harmónia",
		eyebrow: "Felnőtteknek",
		title: "Nem baj, ha még sosem lovagoltál",
		text: "Az első alkalom nem a teljesítményről szól. Megismerjük egymást, közel kerülünk a lóhoz, és olyan gyakorlatokkal haladunk, amelyekben biztonságban érzed magad.",
		items: [
			"kezdőknek és újrakezdőknek is",
			"nyugodt, feltöltő kikapcsolódás",
			"személyre szabott foglalkozás",
		],
		cta: "Részletek felnőtteknek",
	},
];
---

<section class="programs section">
	<div class="container">
		{
			programs.map((program) => (
				<article
					class:list={["program", { reverse: program.reverse }]}
					id={program.id}
				>
					<>
						<div class="program-image">
							<>
								<img
									src={program.image}
									alt={program.alt}
									width="1600"
									height="1200"
									loading="lazy"
								/>
								<span class="image-label">{program.label}</span>
							</>
						</div>
						<div class="program-copy">
							<>
								<p class="eyebrow">{program.eyebrow}</p>
								<h2>{program.title}</h2>
								<p>{program.text}</p>
								<ul class="plain-list">
									{program.items.map((item) => (
										<li>
											<i
												class="bi bi-check2-circle"
												aria-hidden="true"
											/>
											{item}
										</li>
									))}
								</ul>
								<a
									class="button button-outline"
									href={program.href}
								>
									{program.cta}{" "}
									<i
										class="bi bi-arrow-right"
										aria-hidden="true"
									/>
								</a>
							</>
						</div>
					</>
				</article>
			))
		}
	</div>
</section>
