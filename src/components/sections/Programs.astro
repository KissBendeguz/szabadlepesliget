---
const programs = [
	{
		id: "gyerekeknek",
		href: "/foglalkozasok/mozgas-es-kepessegfejlesztes/",
		image: "/gallery/4999ae9c-6d55-4fe7-82ce-67ed8c19cb83.webp",
		alt: "Gyermek játékos gyakorlatot végez a ló hátán",
		label: "Játék · mozgás · öröm",
		eyebrow: "Gyerekeknek",
		title: "Mozgás- és képességfejlesztés lóháton",
		text: "A ló hátán a mozgás élménnyé válik. Játékos feladatokkal, sok bátorítással és a gyermek egyéni tempójához igazodva támogatjuk a kibontakozást.",
		items: [
			"egyensúly és koordináció támogatása",
			"figyelem és önbizalom erősítése",
			"testtudat és önállóság támogatása",
		],
		cta: "Részletek gyerekeknek",
	},
	{
		id: "felnotteknek",
		href: "/foglalkozasok/loasszisztalt-onismeret/",
		reverse: true,
		image: "/gallery/1f090c7c-81cd-4739-8745-70c342a5adca.webp",
		alt: "Felnőtt kapcsolódik egy lóhoz önismereti foglalkozáson",
		label: "Jelenlét · kapcsolódás · önreflexió",
		eyebrow: "Felnőtteknek",
		title: "Önismereti találkozás a ló mellett",
		text: "A ló őszinte visszajelzései segíthetnek megfigyelni saját érzéseidet, határaidat és kapcsolódási mintáidat. A foglalkozás a földről történik, nem kell lóra ülnöd.",
		items: [
			"nem szükséges lovas tapasztalat",
			"a foglalkozás a ló mellett zajlik",
			"személyes, biztonságos keretek",
		],
		cta: "Részletek felnőtteknek",
	},
];
---

<section class="programs section">
	<div class="container">
		{
			programs.map((program) => (
				<article
					class:list={["program", { reverse: program.reverse }]}
					id={program.id}
				>
					<>
						<div class="program-image">
							<>
								<img
									src={program.image}
									alt={program.alt}
									width="1600"
									height="1200"
									loading="lazy"
								/>
								<span class="image-label">{program.label}</span>
							</>
						</div>
						<div class="program-copy">
							<>
								<p class="eyebrow">{program.eyebrow}</p>
								<h2>{program.title}</h2>
								<p>{program.text}</p>
								<ul class="plain-list">
									{program.items.map((item) => (
										<li>
											<i
												class="bi bi-check2-circle"
												aria-hidden="true"
											/>
											{item}
										</li>
									))}
								</ul>
								<a
									class="button button-outline"
									href={program.href}
								>
									{program.cta}{" "}
									<i
										class="bi bi-arrow-right"
										aria-hidden="true"
									/>
								</a>
							</>
						</div>
					</>
				</article>
			))
		}
	</div>
</section>
