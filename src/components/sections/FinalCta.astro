---
import { site } from "../../data/site";
---

<section class="final-cta section" id="kapcsolat">
    <div class="container final-inner">
        <div>
            <p class="eyebrow light">Kezdődhet a közös kaland?</p><h2>
                Találkozzunk Káptalantótiban!
            </h2><p>
                Kérj időpontot gyermeked fejlesztő foglalkozásához vagy saját
                lóval való önismereti találkozásodhoz.
            </p>
        </div><div class="cta-actions">
            <a class="button button-warm" href={site.phoneLink}
                ><i class="bi bi-telephone" aria-hidden="true"></i>{
                    site.phoneDisplay
                }</a
            ><a class="button button-cream" href={site.phoneLink}
                >Időpontot kérek <i class="bi bi-arrow-right" aria-hidden="true"
                ></i></a>
        </div>
    </div>
</section>
